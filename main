<body>
<h1>⚡ ЭнергоХранитель</h1>
<div id="score">Сэкономлено энергии: 0 кВт·ч</div>
<button id="btn">ВЫКЛЮЧИТЬ СВЕТ</button>
<div id="info">Нажимай кнопку, чтобы выключать свет и экономить энергию. Чем быстрее — тем больше экономия!</div>
<script>
let saved=0, last=Date.now();
const btn=document.getElementById('btn');
const scoreEl=document.getElementById('score');
btn.onclick=()=>{
  const now=Date.now();
  const bonus=Math.max(1, Math.floor(2000/(now-last+100)));
  saved+=bonus;
  scoreEl.textContent=`Сэкономлено энергии: ${saved} кВт·ч`;
  btn.style.background = saved>50?'#ffd600':(saved>20?'#00b0ff':'#00c853');
  last=now;
};
</script>
</body>
