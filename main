<style>
body{margin:0;font-family:sans-serif;background:#0f2027;color:#fff;
display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh}
#score{font-size:22px;margin:10px}
#btn{padding:15px 40px;font-size:20px;border:none;border-radius:12px;
